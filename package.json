{
  "name": "fieldnote-sightings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/fieldnote", "apps/reader"],
  "scripts": {
    "dev": "npm run dev -w @fieldnote/writer",
    "dev:reader": "npm run dev -w @fieldnote/reader",
    "build": "npm run build -w @fieldnote/writer && npm run build -w @fieldnote/reader",
    "typecheck": "npm run typecheck --workspaces",
    "test": "tsx --test tests/*.test.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:notebook": "tsx scripts/verify-notebook.ts",
    "format": "prettier --write --ignore-path .gitignore apps format docs scripts tests README.md"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "prettier": "3.9.8"
  },
  "engines": {"node": "22.x"}
}
