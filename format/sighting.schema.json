{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "org.fieldnote.sighting"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "species": {
      "type": "object",
      "properties": {
        "commonName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "scientificName": {
          "type": "string",
          "maxLength": 160
        }
      },
      "required": ["commonName", "scientificName"]
    },
    "observed": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "time": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "utcOffset": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[+-](0\\d|1[0-4]):[0-5]\\d$"
            },
            {
              "type": "null"
            }
          ]
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": ["day", "minute"]
        }
      },
      "required": ["date", "time", "utcOffset", "timezone", "precision"]
    },
    "place": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "datum": {
          "type": "string",
          "const": "WGS84"
        },
        "uncertaintyMeters": {
          "type": "number",
          "minimum": 1,
          "maximum": 500000
        },
        "source": {
          "type": "string",
          "enum": ["manual", "device"]
        }
      },
      "required": [
        "name",
        "latitude",
        "longitude",
        "datum",
        "uncertaintyMeters",
        "source"
      ]
    },
    "observer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "identityAddress": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      },
      "required": ["name", "identityAddress"]
    },
    "publisher": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "appOrigin": {
          "type": "string",
          "maxLength": 300,
          "format": "uri"
        }
      },
      "required": ["owner", "appOrigin"]
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "notes": {
      "type": "string",
      "maxLength": 3000
    },
    "photo": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reference": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "endpoint": {
              "type": "string",
              "const": "bytes"
            },
            "mediaType": {
              "type": "string",
              "enum": ["image/jpeg", "image/png", "image/webp"]
            },
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5242880
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "caption": {
              "type": "string",
              "maxLength": 500
            },
            "credit": {
              "type": "string",
              "maxLength": 200
            }
          },
          "required": [
            "reference",
            "endpoint",
            "mediaType",
            "bytes",
            "sha256",
            "caption",
            "credit"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "demonstration": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "recordedAt",
    "species",
    "observed",
    "place",
    "observer",
    "publisher",
    "count",
    "notes",
    "photo",
    "demonstration"
  ],
  "$id": "https://raw.githubusercontent.com/hrsh22/fieldnote-sightings/main/format/sighting.schema.json",
  "title": "Fieldnote sighting version 1"
}
